# ==== Dasar ====
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4001
API_PORT=4001

# ==== Infra (docker compose up -d) ====
DATABASE_URL=postgres://platform:platform@localhost:5432/platform
REDIS_URL=redis://localhost:6379

# ==== Aplikasi Discord untuk LOGIN dashboard ====
# https://discord.com/developers/applications -> New Application -> OAuth2
# Tambahkan Redirect: http://localhost:3000/api/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ==== Secret — generate: openssl rand -hex 32 ====
SESSION_SECRET=
# Kunci AES-256-GCM, WAJIB 64 karakter hex. Jangan pernah diubah setelah ada bot terdaftar.
TOKEN_ENCRYPTION_KEY=

# Produksi: origin API yang dapat diakses publik (dipakai untuk URL webhook integrasi).
# Kosongkan di lokal (fallback = API_URL).
PUBLIC_API_URL=

LOG_LEVEL=info
